{
  "manifest_version": 3,
  "name": "Jev Browser tabs",
  "version": "0.1.0",
  "description": "Keeps an automation agent's tabs in a tab group of their own and out of your way.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "webNavigation"
  ],
  "background": {
    "service_worker": "sw.js"
  }
}
