{
  "name": "barq-mcp",
  "version": "0.2.1",
  "description": "Fast browser hands for coding agents: the agent names an outcome, Jev (TypeSafe's decision model) picks each click in about 300 ms. MCP server, Claude Code plugin, library and CLI; works in a browser it launches or in your own Chrome or Edge.",
  "keywords": [
    "barq",
    "jev",
    "jev-browser",
    "typesafe",
    "system-one",
    "mcp",
    "mcp-server",
    "claude",
    "claude-code",
    "claude-code-plugin",
    "browser-automation",
    "browser-agent",
    "ai-agent",
    "playwright",
    "llm",
    "agent"
  ],
  "license": "MIT",
  "author": "Ibrahim Hajjaj (https://github.com/ibrahimhajjaj)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibrahimhajjaj/barq.git"
  },
  "homepage": "https://github.com/ibrahimhajjaj/barq#readme",
  "bugs": {
    "url": "https://github.com/ibrahimhajjaj/barq/issues"
  },
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "bin": {
    "barq": "bin/barq.mjs",
    "barq-mcp": "bin/barq-mcp.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "extension/",
    "examples/",
    "skills/",
    "README.md",
    "NOTES.md",
    "RESULTS.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=180000 test/*.test.mjs",
    "test:e2e": "node ./test/mcp.e2e.mjs",
    "bench": "node ./bench/run.mjs",
    "bench:cost": "node ./bench/context-cost.mjs",
    "mcp": "node bin/barq-mcp.mjs",
    "setup": "playwright install chromium"
  },
  "engines": {
    "node": ">=20.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": ">=1.30.0 <2.0.0",
    "playwright": "^1.63.0",
    "tldts": "^7.4.13",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  }
}
